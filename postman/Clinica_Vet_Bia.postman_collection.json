        {
          "name": "Cadastrar veterinário (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// gera um CPF válido e dados únicos a cada execução",
                  "const n = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
                  "const dv = (b) => { const s = b.reduce((t, d, i) => t + d * (b.length + 1 - i), 0); const r = (s * 10) % 11; return r >= 10 ? 0 : r; };",
                  "n.push(dv(n)); n.push(dv(n));",
                  "const sufixo = Date.now();",
                  "pm.collectionVariables.set('novoCpf', n.join(''));",
                  "pm.collectionVariables.set('novoEmail', 'vet' + sufixo + '@clinica.test');",
                  "pm.collectionVariables.set('novoCrmv', String(sufixo).slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const vet = pm.response.json();",
                  "pm.test('Nasce ativo e com a senha não confirmada', () => { pm.expect(vet.status).to.eql('ativo'); pm.expect(vet.senhaConfirmada).to.eql(false); });",
                  "pm.test('Não devolve a senha', () => pm.expect(vet).to.not.have.any.keys('senha', 'hashSenha'));",
                  "pm.collectionVariables.set('vetCriadoId', vet.id);"
                ]
              }
            }
          ],

  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login (pega o token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ativo@clinica.test\",\n  \"senha\": \"{{senhaTeste}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "1 - Cadastro sem a flag fica 'N' (padrão: veio do ViaCEP)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Gera um CPF válido e novo a cada execução (o CPF não pode repetir no banco)",
              "function gerarCpf() {",
              "  const n = Array.from({ length: 9 }, () => Math.floor(Math.random() * 10));",
              "  const dv = (base) => { const s = base.reduce((t, d, i) => t + d * (base.length + 1 - i), 0); const r = (s * 10) % 11; return r === 10 ? 0 : r; };",
              "  n.push(dv(n)); n.push(dv(n));",
              "  return n.join('');",
              "}",
              "pm.collectionVariables.set('cpf', gerarCpf());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test(\"cadastroManual = 'N'\", () => pm.expect(pm.response.json().endereco.cadastroManual).to.eql('N'));",
              "pm.collectionVariables.set('tutorId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/tutores",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "tutores"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Teste Flag Padrão\",\n  \"cpf\": \"{{cpf}}\",\n  \"endereco\": {\n    \"cep\": \"01001000\",\n    \"logradouro\": \"Praça da Sé\",\n    \"numero\": \"1\",\n    \"bairro\": \"Sé\",\n    \"cidade\": \"São Paulo\",\n    \"uf\": \"SP\",\n    \"codigoIbge\": \"3550308\"\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },

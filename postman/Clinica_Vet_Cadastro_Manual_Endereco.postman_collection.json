              "const lista = pm.response.json();",
              "pm.test('Todos os endereços têm cadastroManual S ou N', () => lista.forEach((t) => pm.expect(['S', 'N']).to.include(t.endereco.cadastroManual)));",
              "pm.test('O tutor do teste aparece com S', () => pm.expect(lista.find((t) => t.id === Number(pm.collectionVariables.get('tutorId'))).endereco.cadastroManual).to.eql('S'));"
